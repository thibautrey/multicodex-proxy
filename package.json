{
  "name": "multivibe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && npm run build:api",
    "test": "tsx --test \"src/**/*.test.ts\" \"web/test/**/*.test.ts\"",
    "start": "node --import ./dist/instrument.js dist/server.js"
  },
  "dependencies": {
    "@foxglove/wasm-zstd": "^1.0.1",
    "@sentry/node": "^9.47.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^1.20.6",
    "express": "^4.22.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
