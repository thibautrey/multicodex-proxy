{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multivibe.cloud/schemas/provider-runtime-profiles.schema.json",
  "title": "MultiVibe provider runtime profile catalog v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "catalog_digest", "license", "provenance", "profiles"],
  "properties": {
    "schema_version": { "const": "provider-runtime-profile-catalog-v3" },
    "format": { "const": "multivibe-runtime-profile-catalog" },
    "catalog_digest": { "$ref": "#/$defs/digest" },
    "license": { "$ref": "#/$defs/license" },
    "provenance": { "$ref": "#/$defs/catalog_provenance" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$" },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^(?!(?:https?|file|ftp|ssh|data):)[a-z][a-z0-9-]{0,31}:[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,127}(/[a-z0-9][a-z0-9._-]{0,127})*$"
    },
    "catalog_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "source_digest"],
      "properties": {
        "source_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "migrated_from": { "const": "provider-runtime-workload-profile-v2" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "profile_digest", "priority", "model", "hardware", "runtime", "tuning", "provenance"],
      "properties": {
        "schema_version": { "const": "provider-runtime-profile-v3" },
        "id": { "$ref": "#/$defs/name" },
        "profile_digest": { "$ref": "#/$defs/digest" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "model": { "$ref": "#/$defs/model" },
        "hardware": { "$ref": "#/$defs/hardware" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "tuning": { "$ref": "#/$defs/tuning" },
        "provenance": { "$ref": "#/$defs/profile_provenance" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_digest", "format", "quantization", "artifact_bytes", "license", "hosted_inference_allowed", "license_assessment_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/model_id" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "format": { "$ref": "#/$defs/slug" },
        "quantization": { "$ref": "#/$defs/slug" },
        "artifact_bytes": { "type": "integer", "minimum": 1, "maximum": 1125899906842624 },
        "license": { "$ref": "#/$defs/license" },
        "hosted_inference_allowed": { "const": true },
        "license_assessment_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "os", "architecture", "accelerator_kind", "minimum_accelerator_memory_bytes", "unified_memory"],
      "properties": {
        "class": { "$ref": "#/$defs/slug" },
        "os": { "$ref": "#/$defs/slug" },
        "architecture": { "$ref": "#/$defs/slug" },
        "accelerator_kind": { "$ref": "#/$defs/slug" },
        "minimum_accelerator_memory_bytes": { "type": "integer", "minimum": 1, "maximum": 1125899906842624 },
        "unified_memory": { "type": "boolean" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "contract_version", "adapter_version", "runtime_artifact_digest"],
      "properties": {
        "backend_id": { "$ref": "#/$defs/slug" },
        "contract_version": { "$ref": "#/$defs/name" },
        "adapter_version": { "$ref": "#/$defs/name" },
        "runtime_artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_tokens", "batch_size", "parallelism", "gpu_offload_layers", "estimated_memory_bytes", "reserve_memory_bytes"],
      "properties": {
        "context_tokens": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "batch_size": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "parallelism": { "type": "integer", "minimum": 1, "maximum": 256 },
        "gpu_offload_layers": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "estimated_memory_bytes": { "type": "integer", "minimum": 1, "maximum": 1125899906842624 },
        "reserve_memory_bytes": { "type": "integer", "minimum": 1, "maximum": 1125899906842624 }
      }
    },
    "profile_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_source_url", "recommendation_digest", "method", "license"],
      "properties": {
        "recommendation_source_url": { "type": "string", "pattern": "^https://", "maxLength": 512 },
        "recommendation_digest": { "$ref": "#/$defs/digest" },
        "method": { "$ref": "#/$defs/slug" },
        "license": { "$ref": "#/$defs/license" }
      }
    }
  }
}
